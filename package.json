{
  "name": "tree-sitter-fga",
  "version": "0.1.0",
  "description": "OpenFGA authorization schema grammar for tree-sitter",
  "main": "bindings/node",
  "types": "bindings/node",
  "author": "Matous Dzivjak",
  "license": "MIT",
  "keywords": [
    "tree-sitter",
    "parser",
    "fga",
    "openfga"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*.scm",
    "src/*.c",
    "src/*.h",
    "src/*.json",
    "src/tree_sitter/*.h",
    "*.wasm"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/matoous/tree-sitter-fga.git"
  },
  "scripts": {
    "generate": "tree-sitter generate --abi 15",
    "build": "npm run generate && node-gyp rebuild",
    "lint": "eslint grammar.js",
    "lint:fix": "eslint --fix grammar.js",
    "test": "node --test bindings/node/*_test.js",
    "test:parser": "tree-sitter test",
    "test:upstream": "node --test test/upstream_test.js",
    "install": "node-gyp-build",
    "prebuildify": "prebuildify --napi --strip",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground"
  },
  "dependencies": {
    "node-addon-api": "^8.9.2",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "eslint": "^9.39.4",
    "eslint-config-treesitter": "^1.0.2",
    "globals": "^17.13.0",
    "prebuildify": "^6.0.1",
    "tree-sitter": "0.25.1",
    "tree-sitter-cli": "0.27.1"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  }
}
